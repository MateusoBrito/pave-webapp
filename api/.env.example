# ---------------------------------------------------------------------------
# Banco (o mesmo que o pave-pipeline popula)
# ---------------------------------------------------------------------------
PAVE_DATABASE_URL=postgresql+asyncpg://postgres:SENHA@localhost:5432/panorama_db

# TLS na conexão: "require" força, "disable" desliga, vazio deixa o driver decidir.
# Postgres local em Docker normalmente não usa TLS.
PAVE_DB_SSL=disable

PAVE_DB_POOL_SIZE=10
PAVE_DB_MAX_OVERFLOW=5

# ---------------------------------------------------------------------------
# CORS — precisa listar a origem do front. JSON list.
# ---------------------------------------------------------------------------
PAVE_CORS_ORIGINS='["http://localhost:5173"]'

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# Caminho do service account JSON do Firebase. Vazio = Application Default
# Credentials (variável GOOGLE_APPLICATION_CREDENTIALS).
PAVE_FIREBASE_CREDENTIALS_FILE=

# true desliga a verificação do ID token. SÓ em desenvolvimento — com isso qualquer
# requisição é aceita como se fosse de um usuário logado.
PAVE_AUTH_DISABLED=true
